{
    "name": "instance-generator-app",
    "scripts": {
        "start-ui": "npm --prefix ui run start",
        "start-backend": "cd backend && uv run fastapi dev main.py",
        "start": "concurrently \"npm run start-backend\" \"npm run start-ui\"",
        "docker:desktop": "powershell -ExecutionPolicy Bypass -File .\\run-desktop.ps1"
    },
    "devDependencies": {
        "concurrently": "^10.0.5"
    }
}
